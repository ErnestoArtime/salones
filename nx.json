{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/libs/**/*",
        "{workspaceRoot}/tokens.css",
        "{workspaceRoot}/angular.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    }
  }
}
