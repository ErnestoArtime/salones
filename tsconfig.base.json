{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@beauty/contracts": ["libs/contracts/src/index.ts"],
      "@beauty/data-access": ["libs/data-access/src/api.ts"]
    }
  }
}
