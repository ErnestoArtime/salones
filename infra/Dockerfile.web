FROM node:24.18.0-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec ng build salon-app && pnpm exec ng build booking-web --base-href /booking/ && pnpm exec ng build superadmin --base-href /admin/
FROM caddy:2.11.2-alpine
COPY --from=build /app/dist/apps/salon-app/browser /srv/salon
COPY --from=build /app/dist/apps/booking-web/browser /srv/booking
COPY --from=build /app/dist/apps/superadmin/browser /srv/admin
COPY infra/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
