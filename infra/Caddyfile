:80 {
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:4310
  }
  handle_path /auth/v1/* {
    reverse_proxy auth:9999
  }
  redir /booking /booking/ 308
  redir /admin /admin/ 308
  handle_path /booking/* {
    root * /srv/booking
    try_files {path} /index.html
    file_server
  }
  handle_path /admin/* {
    root * /srv/admin
    try_files {path} /index.html
    file_server
  }
  handle {
    root * /srv/salon
    try_files {path} /index.html
    file_server
  }
}
