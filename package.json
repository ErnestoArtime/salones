{
  "name": "beauty-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nx run-many -t build --parallel=2",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "dev": "nx run-many -t serve --parallel=4",
    "infra:up": "docker compose up -d db auth rest storage mail",
    "setup": "node tools/setup.mjs",
    "db:migrate": "node tools/migrate.mjs",
    "seed": "node tools/seed.mjs",
    "backup": "bash tools/backup.sh",
    "configure": "node tools/setup.mjs"
  },
  "dependencies": {
    "@ai-sdk/replicate": "3.0.64",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@ionic/angular": "9.0.8",
    "@mediapipe/tasks-vision": "1.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@runwayml/sdk": "4.24.0",
    "ai": "7.0.145",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "tslib": "2.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "nx": "23.3.0",
    "typescript": "6.0.3",
    "yaml": "2.8.2"
  }
}
