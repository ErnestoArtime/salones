{
  "name": "api",
  "tags": ["type:app", "platform:server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/api"],
      "options": {
        "command": "tsc -p apps/api/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file=.env --watch dist/api/apps/api/src/main.js"
      }
    }
  },
  "implicitDependencies": ["contracts"]
}
