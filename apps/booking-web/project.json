{
  "name": "booking-web",
  "tags": ["type:app", "platform:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/booking-web"],
      "options": {
        "command": "ng build booking-web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve booking-web"
      }
    }
  },
  "implicitDependencies": ["contracts", "data-access", "ui"]
}
