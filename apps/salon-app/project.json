{
  "name": "salon-app",
  "tags": ["type:app", "platform:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/salon-app"],
      "options": {
        "command": "ng build salon-app"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve salon-app"
      }
    }
  },
  "implicitDependencies": ["contracts", "data-access", "ui"]
}
